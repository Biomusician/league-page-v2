# League-Page private configuration — NAMES ONLY, never real values here.
#
# Copy to `.env` (gitignored) and fill in. `.env` must never be committed.
# The same names go into the PRIVATE Commissioner Vercel project's
# environment variables later — never into the public site project.

# ---------------------------------------------------------------- Supabase
# Project URL, e.g. https://<project-ref>.supabase.co   (not secret)
SUPABASE_URL=

# Publishable / anon key (browser-safe by Supabase's design). This app still
# uses it server-side only: the OTP exchange happens on the server, so no
# key is ever handed to the browser.                     (not secret)
SUPABASE_PUBLISHABLE_KEY=

# SECRET — server only, bypasses Row Level Security. Needed only for
# administrative work (schema migration, service tasks). Leave blank until
# a step actually requires it.
SUPABASE_SECRET_KEY=

# SECRET — direct Postgres connection string (contains the password).
# Needed to run schema migrations from this machine.
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# ------------------------------------------------------------------- Auth
# off      = localhost fallback, no login (current local Desk behaviour)
# required = every private route needs a Commissioner session (hosted)
LEAGUEPAGE_AUTH_MODE=off

# Comma-separated allowlist. A valid Supabase user NOT listed here is still
# denied. There is no sign-up.
LEAGUEPAGE_COMMISSIONER_EMAILS=

# SECRET — signs session cookies. Required when LEAGUEPAGE_AUTH_MODE=required.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
LEAGUEPAGE_SECRET_KEY=

# ------------------------------------------------------------------- Mail
# log (default; writes logs/login-links.log) | resend
# Supabase Auth sends its own OTP email, so this is only for non-Supabase
# fallback sign-in and, later, Phase 3 email authoring.
LEAGUEPAGE_MAIL_PROVIDER=log
LEAGUEPAGE_MAIL_FROM=
RESEND_API_KEY=
