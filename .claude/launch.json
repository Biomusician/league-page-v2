{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-site",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--directory",
        "dist",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8090
    },
    {
      "name": "desk-qa",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "scripts/desk.py",
        "--port",
        "8031",
        "--strict-port"
      ],
      "port": 8031
    }
  ]
}
