.venv/
__pycache__/
*.pyc
# .env.local and .env.production were NOT covered by a bare `.env`.
# The repo audit would flag them, but only when somebody remembers to
# run it, and the audit is convention rather than a hook.
.env
.env.*
!.env.example
data/
site/
.site-worktree/
dist/
dist-preview/
.pytest_cache/

# Privacy: real Sleeper handles/identities stay local-only (see SKILL.md
# hygiene rule). Schema documented in editorial/managers.example.json.
editorial/managers.json
# Regenerable packet/dossier output carries manager display names from the DB.
editorial/**/generated/
editorial/**/dossiers/
# App-generated prep packs also carry manager display names; regenerable.
editorial/**/PREP.md
# Jonathan's own matchup notes reference managers by handle; local-only,
# like managers.json (decision 2026-08-30).
editorial/**/commissioner_notes.md
# Git-history backup bundles stay local.
*.bundle
logs/
*.log

# Commissioner state backups: prose + private manager context. Never commit.
backups/
